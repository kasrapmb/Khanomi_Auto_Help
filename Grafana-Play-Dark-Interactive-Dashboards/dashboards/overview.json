  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "checkout,orders,payments,search",
        "current": {
          "text": "checkout",
          "value": "checkout"
        },
        "options": [
          {
            "text": "checkout",
            "value": "checkout",
            "selected": true
          },
          {
            "text": "orders",
            "value": "orders",
            "selected": false
          },
          {
            "text": "payments",
            "value": "payments",
            "selected": false
          },
          {
            "text": "search",
            "value": "search",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
