  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "stat",
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "demo-testdata"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "demo-testdata"
          },
          "scenarioId": "random_walk",
          "alias": "Requests / ${service}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
